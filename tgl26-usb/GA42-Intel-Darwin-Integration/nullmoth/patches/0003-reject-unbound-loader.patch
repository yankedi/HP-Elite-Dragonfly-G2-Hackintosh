Subject: [PATCH] plugin: reject unknown vendor before any Vulkan loader path

Apply after 0001 and 0002. Never pass a NULL ICD path to dlopen or let an
unbound process fall through to ambient libvulkan discovery.

--- a/plugin/nvmtl_vk.c
+++ b/plugin/nvmtl_vk.c
@@ -725,6 +725,12 @@
     if (g_state) return g_state == 1 ? 0 : -1;
     g_state = -1;
     nvmtl_vk_freeze_vendor();
+    const char *selected_lib = nvmtl_icd_lib_path();
+    const char *selected_json = nvmtl_vk_icd_json();
+    if (!selected_lib || !selected_json) {
+        nvlog("vk: no supported accelerator binding; refusing loader discovery");
+        return -1;
+    }
     if (!getenv("NVRM_FLUSH_TIMEOUT_MS")) {
         char budget[32]; snprintf(budget, sizeof budget, "%ld", nvmtl_gpu_wait_budget_ms());
         setenv("NVRM_FLUSH_TIMEOUT_MS", budget, 1);
@@ -748,1 +754,1 @@
-    g_lib = dlopen(NVMTL_ICD_LIB, RTLD_NOW | RTLD_LOCAL);
+    g_lib = dlopen(selected_lib, RTLD_NOW | RTLD_LOCAL);
@@ -770,3 +776,3 @@
     if (!pvkGetInstanceProcAddr) {
-        if (!getenv("VK_ICD_FILENAMES")) setenv("VK_ICD_FILENAMES", NVMTL_ICD, 1);
+        if (!getenv("VK_ICD_FILENAMES")) setenv("VK_ICD_FILENAMES", selected_json, 1);
         g_lib = dlopen(NVMTL_LOADER, RTLD_NOW | RTLD_LOCAL);
