+		uint32_t transConf = NGreen::callback->readReg32(0x70008 + p * 0x1000);
+		if (transConf != 0xFFFFFFFFu && (transConf & 0x80000000u) != 0) {
+			uint32_t pCscReg = 0x701CC + p * 0x1000;
+			uint32_t pCsc = NGreen::callback->readReg32(pCscReg);
