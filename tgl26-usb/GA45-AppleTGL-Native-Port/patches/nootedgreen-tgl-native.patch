+// GA4.4: native Tiger Lake / Tahoe profile.  This is deliberately a
+// separate switch from -ngreenxefix: xefix bundles display-13 and RPL
+// workarounds that must not run on a real TGL (CPUID model 0x8C/0x8D).
+static bool xeTglTahoeEnabled() {
+	static int v = -1;
+	if (v < 0) v = checkKernelArgument("-ngreentgltahoe") ? 1 : 0;
+	return v == 1;
+}
+static void applyTglTahoeLayoutFixes(KernelPatcher &patcher, KernelPatcher::KextInfo *kext,
+                                     mach_vm_address_t address, size_t size) {
+	if (!NGreen::callback || !NGreen::callback->getIsRealTGL() || !xeTglTahoeEnabled()) return;
+
+	// XE-FMT: 16.0.32 performTransaction+0x81361 reads IOSurface+0xa4.
+	// On Tahoe that field is stale/zero, so force the desktop 'BGRA' value.
+	static const uint8_t fmt_old[] = {0x8b, 0x83, 0xa4, 0x00, 0x00, 0x00, 0x89, 0x85, 0xf4, 0xfe, 0xff, 0xff};
+	static const uint8_t fmt_new[] = {0xb8, 0x41, 0x52, 0x47, 0x42, 0x90, 0x89, 0x85, 0xf4, 0xfe, 0xff, 0xff};
+	LookupPatchPlus const fmtPatch[] = {{kext, fmt_old, fmt_new, arrsize(fmt_old), 1}};
+	bool fmt_ok = LookupPatchPlus::applyAll(patcher, fmtPatch, address, size);
+
+	// XE-PLANES2: the same 16.0.32 driver reads the plane count from
+	// IOSurface+0xb0; the 25G241/25G83 object exposes it through the
+	// getPlaneCount path.  +0x98 is the 25G241 raw offset and is only a
+	// candidate for 25G83 until the target binary confirms it.
+	static const uint8_t planes_old[] = {0x8b, 0x83, 0xb0, 0x00, 0x00, 0x00, 0x85, 0xc0, 0xba, 0x01, 0x00, 0x00, 0x00};
+	static const uint8_t planes_new[] = {0x8b, 0x83, 0x98, 0x00, 0x00, 0x00, 0x85, 0xc0, 0xba, 0x01, 0x00, 0x00, 0x00};
+	LookupPatchPlus const planesPatch[] = {{kext, planes_old, planes_new, arrsize(planes_old), 1}};
+	bool planes_ok = LookupPatchPlus::applyAll(patcher, planesPatch, address, size);
+
+	SYSLOG("ngreen", "TGL-Tahoe: XE-FMT %s, XE-PLANES2 %s (target offset still needs validation)",
+	       fmt_ok ? "applied" : "NOT found", planes_ok ? "applied" : "NOT found");
+}
