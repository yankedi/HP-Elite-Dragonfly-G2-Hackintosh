+// xe/nooted fix: the published code reads through the static `callback`, which is never assigned
+// (its setter in HookCase::start is commented out), so probePortMode dereferenced NULL. Read the
+// register through the framebuffer controller's own MMIO mapping instead, like WriteRegister32 does.
+static uint32_t hcControllerRead32(void *bc, uint32_t reg) {
+    if (bc == nullptr) return 0xffffffff;
+    uint64_t mmio = *reinterpret_cast<uint64_t *>(static_cast<uint8_t *>(bc) + 0x9B0);
+    uint32_t len = *reinterpret_cast<uint32_t *>(static_cast<uint8_t *>(bc) + 0xC78);
+    if (mmio == 0 || (uint64_t)reg + 4 > len) return 0xffffffff;
+    return *reinterpret_cast<volatile uint32_t *>(mmio + reg);
+}
